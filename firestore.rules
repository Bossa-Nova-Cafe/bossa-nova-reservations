rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // L'équipe : les e-mails de la liste « Équipe » (accueil de l'administration).
    // Tant que la liste n'est pas activée, tout compte connecté est admin (comme avant).
    function admin() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/parametres/equipe)
            || request.auth.token.email.lower() in get(/databases/$(database)/documents/parametres/equipe).data.emails);
    }
    // Les managers : la liste « managers » du même document. Sans cette liste, chaque membre de l'équipe est manager.
    function manager() {
      return admin()
        && (!exists(/databases/$(database)/documents/parametres/equipe)
            || !('managers' in get(/databases/$(database)/documents/parametres/equipe).data)
            || request.auth.token.email.lower() in get(/databases/$(database)/documents/parametres/equipe).data.managers);
    }
    function soiree(id) { return get(/databases/$(database)/documents/soirees/$(id)).data; }

    // Soirées : lecture publique (le site doit les afficher sans connexion).
    // Écriture réservée à l'équipe, sauf le compteur de places qui monte lors d'une réservation.
    match /soirees/{id} {
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pax'])
            && request.resource.data.pax > resource.data.pax
            && request.resource.data.pax <= resource.data.cap
            && resource.data.ferme == false);
    }

    // Réservations : création publique mais validée ; noms et contacts illisibles sans connexion.
    match /reservations/{id} {
      allow read, update, delete: if admin();
      allow create: if
        request.resource.data.keys().hasAll(['ev','nom','pax','slot','code','ts'])
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 1
        && request.resource.data.nom.size() < 120
        && request.resource.data.pax is int
        && request.resource.data.pax >= soiree(request.resource.data.ev).min
        && request.resource.data.pax <= 12
        && request.resource.data.slot in soiree(request.resource.data.ev).slots
        && soiree(request.resource.data.ev).ferme == false;
    }

    // Festa : catalogue lisible par tous, modifiable par l'équipe
    match /parametres/confra-catalogue {
      allow read: if true;
      allow write: if admin();
    }
    // Festa : offres personnalisées et achats des soirées, réservés à l'équipe
    match /parametres/confra-offres {
      allow read, write: if admin();
    }
    match /parametres/confra-achats {
      allow read, write: if admin();
    }

    // Équipe : la liste des e-mails autorisés, gérée depuis l'accueil de l'administration
    match /parametres/equipe {
      allow read: if request.auth != null;
      allow write: if manager();
    }

    // Stock du café : réservé à l'équipe
    match /stock-articles/{id} {
      allow read, write: if admin();
    }
    match /stock-mouvements/{id} {
      allow read, write: if admin();
    }

    // Caisse : chaque membre saisit et envoie sa fermeture ; seul un manager la clôture.
    // Une fermeture clôturée ne se corrige que par un manager connecté, avec une entrée ajoutée au journal à son nom.
    match /caisse-fermetures/{id} {
      allow read: if admin();
      allow create: if admin() && request.resource.data.statut != 'cloturee';
      allow update: if (resource.data.statut != 'cloturee'
          && (manager() || (admin() && request.resource.data.statut != 'cloturee')))
        || (resource.data.statut == 'cloturee' && manager()
          && request.resource.data.statut == 'cloturee'
          && request.resource.data.journal.size() == resource.data.get('journal', []).size() + 1
          && request.resource.data.journal.hasAll(resource.data.get('journal', []))
          && request.resource.data.journal[request.resource.data.journal.size() - 1].action == 'Modification après clôture'
          && request.resource.data.journal[request.resource.data.journal.size() - 1].par == request.auth.token.email.lower());
      allow delete: if resource.data.statut != 'cloturee'
        && (manager() || (admin() && resource.data.statut == 'brouillon'));
    }
  }
}
